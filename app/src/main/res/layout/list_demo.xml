

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/img10"
    android:padding="8dp">

    <ImageView
        android:id="@+id/image_view_Demo"
        android:layout_width="200dp"
        android:layout_height="240dp"
        android:scaleType="centerCrop"
        android:src="@drawable/upload" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="185dp"
        android:layout_marginStart="15dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_view_Room_Types"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:textSize="20sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/text_view_Room_Price"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_booking"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Booking"
            android:padding="15dp"
            android:backgroundTint="#237A85"
            android:textColor="@color/white"
            android:layout_marginEnd="10dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_booked"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:text="Booked"
            android:background="#237A85"
            android:visibility="gone"
            />



    </LinearLayout>
</LinearLayout>