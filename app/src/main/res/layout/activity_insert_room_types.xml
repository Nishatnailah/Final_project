<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/img9"
    android:padding="19dp"
    tools:context=".InsertRoomTypesActivity">

    <TextView

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="180dp"
        android:text="Insert Demo"
        android:textSize="22sp"
        android:textStyle="bold"/>


    <EditText
        android:id="@+id/et_Room_Types"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Room Types"
        android:inputType="text"
        android:minHeight="48dp"
        android:layout_marginBottom="18dp" />

    <EditText
        android:id="@+id/et_Room_Price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Room Price "
        android:inputType="numberDecimal"
        android:minHeight="48dp"
        android:layout_marginBottom="18dp" />


    <ImageView
        android:id="@+id/iv_selected_image"
        android:layout_width="match_parent"
        android:layout_height="167dp"
        android:layout_marginBottom="16dp"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/upload" />




    <Button
        android:id="@+id/btn_select_image"
        android:layout_width="200dp"
        android:layout_height="62dp"
        android:layout_marginBottom="16dp"
        android:text="Select Image"
        android:backgroundTint="#03A9F4"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btn_insert_demo"
        android:layout_width="200dp"
        android:layout_height="62dp"
        android:text="Insert Demo"
        android:backgroundTint="#4CAF50"
        android:textColor="@color/white"
        android:layout_marginEnd="10dp" />






</LinearLayout>







