<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:background="@drawable/img6"
    android:orientation="vertical"
    tools:context=".LoginActivity">


    <TextView
        android:id="@+id/login_tittle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login"
        android:textColor="#2D6661"
        android:textSize="36sp"
        android:layout_marginBottom="20dp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/singin_tittle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign in to continue"
        android:textColor="#2D6661"
        android:textSize="25sp"
        android:layout_marginBottom="20dp"
       />

    <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:textSize="24sp"
            android:layout_marginBottom="10dp"
            android:inputType="textEmailAddress"
            android:padding="20dp"
            android:background="@android:drawable/button_onoff_indicator_off"
            />




        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:passwordToggleEnabled="true"
            android:textColorHint="#9B9494"



            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:textSize="24sp"
                android:layout_marginBottom="50dp"
                android:inputType="textPassword"
                android:padding="20dp"
                android:background="@android:drawable/button_onoff_indicator_off"

                />
        </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center" >
        <Button
            android:id="@+id/btn_register"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ragisterr"
            android:padding="15dp"
            android:backgroundTint="#1D4E49"
            android:textColor="@color/white"
            android:layout_marginEnd="20dp" />
        <Button
            android:id="@+id/btn_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/login"
            android:padding="15dp"
            android:backgroundTint="#138394"
            android:textColor="@color/white"
            android:layout_marginEnd="10dp" />


    </LinearLayout>





</LinearLayout>






